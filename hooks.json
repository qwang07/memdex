{
  "memdex": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./bin/memdex.mjs hook session-start --host antigravity",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./bin/memdex.mjs hook stop --host antigravity",
        "timeout": 15
      }
    ]
  }
}
